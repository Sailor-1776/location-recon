{
  "name": "location-recon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/cli/reconcile.ts",
    "lookup": "tsx src/cli/lookup.ts",
    "visualize": "tsx src/cli/visualize.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "format": "prettier -w .",
    "ui:dev": "PORT=3001 HOSTNAME=127.0.0.1 next dev src/server/next",
    "ui:dev:mr8": "MR8_DRIVER=csv LOCATIONS_CSV_PATH='/Users/wyriv/Research Tool/location-recon/data/mr8_locations.csv' PORT=3001 HOSTNAME=127.0.0.1 next dev src/server/next",
    "lookup:mr8": "MR8_DRIVER=csv LOCATIONS_CSV_PATH='/Users/wyriv/Research Tool/location-recon/data/mr8_locations.csv' tsx src/cli/lookup.ts"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1",
    "dotenv": "^16.4.5",
    "fuzzball": "^2.2.3",
    "geolib": "^3.3.4",
    "mailparser": "^3.6.9",
    "msgreader": "^1.0.1",
    "mssql": "^10.0.2",
    "next": "^14.2.13",
    "odbc": "^2.4.9",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/react": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.4.5",
    "vitest": "^2.1.3"
  }
}
